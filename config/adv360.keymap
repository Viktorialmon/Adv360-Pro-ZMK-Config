#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC       &kp TILDE  &kp HASH   &kp EXCLAMATION       &kp AMPERSAND          &kp PERCENT  &kp PAGE_DOWN                                                          &kp PG_UP      &kp LESS_THAN  &kp GREATER_THAN  &kp ASTRK        &kp MINUS  &kp AT         &mo 5
&kp CAPS      &kp Q      &kp W      &kp F                 &kp P                  &kp B        &msc SCRL_DOWN                                                         &msc SCRL_UP   &kp J          &kp L             &kp U            &kp Y      &kp BACKSLASH  &kp PIPE
&kp TAB       &kp A      &kp R      &kp S                 &kp T                  &kp G        &kp HOME        &kp LCTRL  &kp LALT          &kp RIGHT_ALT  &kp RCTRL  &kp END        &kp M          &kp N             &kp E            &kp I      &kp O          &kp SQT
&kp LSHFT     &kp Z      &kp X      &kp C                 &kp D                  &kp V                                   &lt 4 EQUAL       &lt 3 SEMI                               &kp K          &kp H             &kp COMMA        &kp DOT    &kp FSLH       &kp RIGHT_SHIFT
&kp LEFT_WIN  &kp LCTRL  &kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS               &kp TAB         &kp SPACE  &lt 1 ESCAPE      &lt 2 DELETE   &kp ENTER  &kp BACKSPACE                 &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp LBKT   &kp RBKT       &kp RIGHT_WIN
            >;
        };

        nav {
            display-name = "Base";
            bindings = <
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                      &mkp RCLK  &mkp LCLK      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MCLK
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                      &trans     &kp LC(LS(Z))  &kp LC(V)       &kp LC(C)       &kp LC(Z)     &kp LC(X)        &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &kp CAPS       &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &trans
&trans  &trans        &trans        &trans     &trans          &trans                  &trans      &trans                     &kp INS        &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
&trans  &trans        &trans        &trans     &trans                  &trans  &trans  &trans      &trans  &trans  &trans                    &trans          &trans          &trans        &trans           &trans
            >;
        };

        num {
            display-name = "Base";
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans  &trans                                      &trans  &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans  &kp N7        &kp N8        &kp N9        &trans  &trans                                      &trans  &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                  &trans      &trans                  &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans  &trans        &trans        &trans                &trans  &trans  &kp N0      &trans  &trans  &trans          &trans           &trans     &trans         &trans         &trans
            >;
        };

        fun {
            display-name = "Base";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F7  &kp F8  &kp F9  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        nvim {
            display-name = "Base";
            bindings = <
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                                    &trans      &mkp MB3       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                                    &trans      &kp LC(LS(Z))  &kp LC(V)       &kp LC(C)       &kp LC(Z)     &kp LC(X)        &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &kp PLUS   &kp MINUS          &trans      &kp CAPS       &kp H           &kp J           &kp K         &kp L            &trans
&trans  &trans        &trans        &trans     &trans          &trans                  &trans      &trans                                    &kp INS        &kp HOME        &kp B           &kp W         &kp END          &trans
&trans  &trans        &trans        &trans     &trans                  &trans  &trans  &trans      &kp COLON  &kp DOUBLE_QUOTES  &kp DOLLAR                 &trans          &trans          &trans        &trans           &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
